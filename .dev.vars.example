# Cloudflare Turnstile's published always-pass keys are safe for local development only.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Replace both values before any public deployment.
REGISTRATION_INVITE_CODE="choose-a-private-local-invite-code"
AUTH_PEPPER="choose-a-long-random-local-pepper-at-least-32-characters"
